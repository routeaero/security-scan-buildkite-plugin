#!/usr/bin/env bash
# security-scan: one step, every build.
#   1. trivy fs  → security-report.json  (vulns in go.mod / package-lock, secrets, misconfig in Dockerfile / k8s / terraform)
#   2. trivy convert → security-report.md (the template in bin/)
#   3. on the agent host: annotate the build page, upload both files, apply the gate
#
# Gate (ADR-0004: this plugin's own CI proves it fails on a planted secret every run):
#   any secret                                  → fail
#   any CRITICAL or HIGH vulnerability with fix → fail
#   misconfigurations: a ratchet. The repo's floor file holds the highest CRITICAL
#   and HIGH counts allowed; exceeding either fails; the floor only moves DOWN,
#   in the same PR as the fix. Accepted findings go in the repo's .trivyignore.yaml
#   WITH an expiry, never bare.
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# RouteAero's registry, not Docker Hub (ADR-0022, roadmap item 163 step v). The
# mirrored copy carries the SAME digest as the upstream index -- the mirror job
# copies the index registry-to-registry -- so this is the identical 0.74.0
# scanner, just fetched from somewhere we control and have scanned.
#
# Digest, not tag: upstream rebuilds tags in place. 0.74.0 multi-arch index,
# mirrored 2026-09-13.
#
# The step running this plugin MUST be able to pull from ECR: it needs the
# aws-assume-role-with-web-identity and ecr plugins beside this one, because
# the docker run below happens on the AGENT HOST, not inside a docker plugin
# container. Without them the pull fails with "no basic auth credentials".
IMAGE="${BUILDKITE_PLUGIN_SECURITY_SCAN_IMAGE:-956087607070.dkr.ecr.us-east-2.amazonaws.com/mirror/trivy@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969}"
FLOOR="${BUILDKITE_PLUGIN_SECURITY_SCAN_FLOOR_FILE:-.buildkite/security-floor}"
SKIP="${BUILDKITE_PLUGIN_SECURITY_SCAN_SKIP_DIRS:-vendor,node_modules,.git,ios,android}"
JSON=security-report.json
MD=security-report.md

ignore_args=()
[ -f .trivyignore.yaml ] && ignore_args=(--ignorefile .trivyignore.yaml)

echo "--- :shield: trivy fs ($IMAGE)"
docker run --rm -v "$PWD":/workdir -w /workdir -v routeaero-trivy-cache:/root/.cache/trivy \
  -e TRIVY_NO_PROGRESS=true "$IMAGE" fs --scanners vuln,secret,misconfig \
  --skip-dirs "$SKIP" ${ignore_args[@]+"${ignore_args[@]}"} --format json --output "$JSON" --quiet .
docker run --rm -v "$PWD":/workdir -w /workdir -v "$PLUGIN_DIR/bin":/plugin:ro "$IMAGE" \
  convert --format template --template @/plugin/security-report.tpl --output "$MD" --quiet "$JSON"

# Defaults first, so a template that emits nothing reads as "found nothing"
# for the report but still fails below on the missing SUMMARY line.
vuln_critical=0; vuln_high=0; vuln_fixable_high=0
misconf_critical=0; misconf_high=0; secrets=0
summary=$(grep '^SUMMARY ' "$MD" | sed 's/^SUMMARY //')
[ -n "$summary" ] || { echo "no SUMMARY line in $MD: the report template did not run"; exit 1; }
# shellcheck disable=SC2086 # the template emits shell-safe key=value pairs only
eval $summary
echo "security: $summary"

floor_critical=0; floor_high=0
if [ -f "$FLOOR" ]; then
  # shellcheck disable=SC1090
  . "./$FLOOR"
fi

fail=""
[ "$secrets" -gt 0 ] && fail="$fail secrets=$secrets"
[ "$vuln_fixable_high" -gt 0 ] && fail="$fail fixable_critical_or_high_vulns=$vuln_fixable_high"
[ "$misconf_critical" -gt "$floor_critical" ] && fail="$fail misconf_critical=$misconf_critical>floor=$floor_critical"
[ "$misconf_high" -gt "$floor_high" ] && fail="$fail misconf_high=$misconf_high>floor=$floor_high"

style=success
[ "$misconf_critical$misconf_high$vuln_critical$vuln_high" != "0000" ] && style=warning
[ -n "$fail" ] && style=error

if command -v buildkite-agent >/dev/null 2>&1 && [ -n "${BUILDKITE_JOB_ID:-}" ]; then
  echo "--- :memo: report"
  {
    echo "**Gate:** ${fail:-passed}. Floor: critical<=$floor_critical high<=$floor_high (\`$FLOOR\`). \`$JSON\` and \`$MD\` are artifacts of this step."
    grep -v '^SUMMARY ' "$MD"
  } | buildkite-agent annotate --context security-scan --style "$style"
  buildkite-agent artifact upload "$JSON;$MD"
fi

if [ -n "$fail" ]; then
  echo "^^^ +++"
  echo "SECURITY GATE FAILED:$fail"
  echo "Fix it, or record an accepted risk in .trivyignore.yaml with an expiry date. Never raise the floor."
  exit 1
fi
echo "security gate passed"
